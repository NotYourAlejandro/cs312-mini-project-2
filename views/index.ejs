<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
        <title>Gwent Image Searcher</title>
    </head>
    <body class="bg-light">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>

        <!-- Header -->
        <div class="navbar sticky-top bg-dark text-white p-4 d-flex shadow justify-content-center">
            <div class="display-5 fw-semibold text-center m-0">Gwent Image Searcher</div>
        </div>

        <!-- Search box -->
        <main class="container">
            <form class="row justify-content-center mt-5" role="search" action="/search" method="get">
                <div class="input-group input-group-lg rounded-3 border p-2 shadow col-12 col-md-10 col-lg-8 col-xl-7">
                    <input class="form-control border-0 bg-transparent shadow-none" type="search" name="query" placeholder="Search" aria-label="Search cards" value="<%= query %>">
                    <button class="btn btn-primary rounded-2 px-4" type="submit" aria-label="Submit search">&rarr;</button>
                </div>
            </form>
        </main>
        
        <% if (results !== null) { %>
            <!-- Render card grid -->
            <main class="container-fluid mt-5 px-3 px-md-4">
                <% if (results.length > 0) { %>
                    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-3">
                        <% results.forEach((card) => { %>
                            <div class="col">
                                <img class="w-100 rounded-4" src="https://gwent.one/image/gwent/assets/card/art/medium/<%= card.artId %>.jpg" loading="lazy" decoding="async">
                                <h2 class="row justify-content-center"><%= card.name %></h2>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="text-center text-secondary">No matching artwork found.</p>
                <% } %>
            </main>
        <% } else { %>
            <!-- Show welcome message -->
            <section class="container mt-5">
                <p class="lead text-center text-secondary">
                    This website provides a searchable database for <a href="https://en.wikipedia.org/wiki/Gwent:_The_Witcher_Card_Game">Gwent</a> cards.
                    Just type in a character or a card you know, and we'll <a href="https://en.wikipedia.org/wiki/Approximate_string_matching">fuzzy-find</a> the image for you!
                </p>
                <br/>
                <p class="lead text-center text-secondary">
                    Huge thank you to <a href="https://api.gwent.one">api.gwent.one</a> for publishing and hosting this API!
                </p>
            </section>
        <% } %>
    </body>
</html>